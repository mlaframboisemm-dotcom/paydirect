# Copy this file to config/.env.credentials and fill with real values.
# This file is loaded by server.ts at startup.
# Optional override path: set SOVEREIGN_CREDENTIALS_FILE=/absolute/path/to/file

# === Exchange payout rails (required for automated payout queue dispatch) ===
COINBASE_API_KEY_ID=
COINBASE_API_SECRET_RAW=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
PAYOUT_FALLBACK_PROVIDER=coinbase

# === Core readiness values currently missing in production checks ===
MARSHALL_WALLET_PRIVATE_KEY=
MAILERSEND_API_KEY=
# OR use SMTP fallback:
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=

# === Optional queue controls ===
PAYOUT_QUEUE_WORKER_ENABLED=true
LEDGER_PAYOUT_EXTERNAL_FALLBACK_ENABLED=true
STRIPE_AUTO_TOPUP_ENABLED=true
