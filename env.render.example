# Render / production env template (example)
# Copy values into Render's Environment Variables (preferred) or Secret Files (/etc/secrets/<name>)
# Replace all REPLACE_ME placeholders with real secrets before deploying.

NODE_ENV=production
PORT=3000

# Core security
# Must be at least 32 characters for production
SOVEREIGN_ENCRYPTION_KEY=REPLACE_ME_32_PLUS_CHAR_SECRET
JWT_SECRET=REPLACE_ME_32_PLUS_CHAR_SECRET
SOVEREIGN_ADMIN_EMAILS=admin@example.com

# Optional bootstrap admin (only for first-run setups)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_TOTP_SECRET=

# Exchange / wallet providers
COINBASE_API_KEY_ID=
COINBASE_API_SECRET_RAW=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
MARSHALL_WALLET_PRIVATE_KEY=
VITE_RPC_ETHEREUM=

# Email delivery (one provider required for production)
MAILERSEND_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Optional integrations
DISCORD_WEBHOOK_URL=
# Path to Google Cloud credentials JSON inside container (optional)
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/gcp.json
SOVEREIGN_SECRET_MANAGER_PROJECT_ID=
SOVEREIGN_SECRET_MANAGER_VERSION=latest
SOVEREIGN_DEV_SECRET_SEED=

# Notes:
# - For Render: add the above keys under Service > Environment > Environment Variables.
# - For file-based secrets on Render, create a Secret File named `.env` or the specific filename
#   and place it under /etc/secrets/<filename> then set GOOGLE_APPLICATION_CREDENTIALS accordingly.
# - Do NOT commit real secrets to this repository. Use the Render dashboard or a secret manager.
