# Full Render-ready environment example (DO NOT commit real secrets)
# Use this as a template when adding Environment Variables in Render.

NODE_ENV=production
PORT=3000

# Core security (required in production; >=32 chars)
SOVEREIGN_ENCRYPTION_KEY=REPLACE_ME_32_PLUS_CHAR_SECRET
JWT_SECRET=REPLACE_ME_32_PLUS_CHAR_SECRET
SOVEREIGN_ADMIN_EMAILS=admin@example.com
SOV_PIN=0000

# Bootstrap admin (optional)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_TOTP_SECRET=

# Exchange / wallet providers (supply either Coinbase or Kraken creds)
COINBASE_API_KEY_ID=
COINBASE_API_SECRET_RAW=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Additional exchange/provider keys that may be used elsewhere
GEMINI_API_KEY=
GEMINI_API_SECRET=
CDP_API_KEY_ID=
CDP_PRIVATE_KEY=

# On-chain wallet
MARSHALL_WALLET_PRIVATE_KEY=
VITE_RPC_ETHEREUM=

# Email delivery (one provider required)
MAILERSEND_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# Optional integrations / infra
DISCORD_WEBHOOK_URL=
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/gcp.json
SOVEREIGN_SECRET_MANAGER_PROJECT_ID=
SOVEREIGN_SECRET_MANAGER_VERSION=latest
SOVEREIGN_DEV_SECRET_SEED=

# Callback / app URLs
FAPI_CALLBACK_URI=
APP_URL=

# Monitoring / external APIs
ETHERSCAN_API_KEY=

# SMS / Telephony
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Bank / rails
INTERAC_PROCESSOR_ID=

# Recaptcha
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Additional runtime flags
PORT=3000
# End of file
