{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx server.ts\" \"tsx scripts/start-interbank.ts\" --names \"SERVER,INTERBANK\" --handle-input true",
    "dev:all": "concurrently \"npm run dev\" \"npm run test\" --names \"[SERVER]\" \"[TESTS]\"",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "start:all": "npm run build && concurrently \"npm run start\" \"npm run test\" --names \"[APP]\" \"[TESTS]\"",
    "clean": "rimraf dist server.js",
    "lint": "tsc --noEmit",
    "test:verify": "tsx scripts/test-verification-system.ts",
    "ledger:backup": "tsx scripts/backup-ledger.ts",
    "cert:pdf": "tsx scripts/generate-pdf.ts",
    "test:verification": "tsx scripts/test-verification-system.ts",
    "test:financial-hardening": "tsx scripts/test-financial-hardening.ts",
    "bridge:check": "tsx scripts/bridge-check.ts",
    "test:auth-security": "tsx scripts/test-auth-security.ts",
    "test:bootstrap-security": "tsx scripts/test-bootstrap-security.ts",
    "test:auth-api-security": "tsx scripts/test-auth-api-security.ts",
    "test:transaction-security": "tsx scripts/test-transaction-security.ts",
    "test:extended-suite": "tsx test-extended-suite.ts",
    "test:production-suite": "tsx test-production-suite.ts",
    "test:final-comprehensive": "tsx test-final-comprehensive.ts",
    "test:e2e": "tsx scripts/test-withdrawal-e2e.ts",
    "verify:prod-env": "node scripts/verify-production-env.mjs",
    "test": "npm run test:verification && npm run test:auth-security && npm run test:bootstrap-security && npm run test:auth-api-security && npm run test:transaction-security",
    "approve-scripts": "npm approve-scripts --allow-scripts-pending",
    "app:init": "cap init",
    "app:add-android": "cap add android",
    "app:sync": "vite build && cap sync",
    "app:open-android": "cap open android"
  },
  "dependencies": {
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.1.2",
    "@google-cloud/secret-manager": "^6.2.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ioredis": "^5.3.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-fetch": "^3.3.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sqlite3": "^6.0.1",
    "vite": "^6.2.3",
    "ethers": "^6.17.0",
    "mailersend": "^2.8.0",
    "nodemailer": "^7.0.13",
    "firebase": "^12.15.0",
    "helmet": "^8.2.0",
    "express-rate-limit": "^8.5.2"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@express-rate-limit/tsconfig": "^1.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "esbuild": "^0.25.0",
    "jspdf": "^3.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.3"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "@google/genai@2.10.0": true,
    "core-js@3.49.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.5": true,
    "sqlite3@6.0.1": true
  }
}
